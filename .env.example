# Copia este archivo a .env y completa los valores marcados con <...>. No subas .env a git.

PORT=8081
# Perfil "local" (local/start-all.ps1): DB_URL/DB_USERNAME/DB_PASSWORD; si faltan usa localhost.
# Cualquier otro entorno (sin perfil local) usa DATABASE_URL/DATABASE_USERNAME/DATABASE_PASSWORD, obligatorias:
# DATABASE_URL=jdbc:postgresql://<host>:5432/<db>
# DATABASE_USERNAME=<usuario>
# DATABASE_PASSWORD=<password>

DB_USERNAME=postgres
DB_PASSWORD=password
DB_POOL_SIZE=4
JWT_SECRET=<jwt_secret>
JWT_EXPIRATION_DAYS=365
APP_INTERNAL_TOKEN=<app_internal_token>
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
SEED_DEFAULT_USERS=true
SEED_ADMIN_EMAIL=admin@edifika.com
# Contrasenas de los usuarios demo. Vacias = no se crean (en el perfil "local" hay una por defecto, ver README).
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=propietario@edifika.com
SEED_OWNER_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
FRONTEND_APP_URL=http://localhost:4200
